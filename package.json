{
  "name": "book-forever",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BOOK FOREVER — librairie numérique ADISEN (chapitres offerts, déblocage à l'unité)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "seed": "node server/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "check:render": "vite build --ssr src/ssr-check.jsx --outDir ../.render-check --emptyOutDir && node .render-check/ssr-check.js",
    "prestart": "node scripts/ensure-build.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.10"
  }
}
