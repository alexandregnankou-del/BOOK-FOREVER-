# ---------------------------------------------------------------------------
# BOOK FOREVER — variables d'environnement
# Copiez ce fichier en « .env » en local, ou renseignez ces clés dans Render.
# ---------------------------------------------------------------------------

# Obligatoire en production : chaîne aléatoire longue (signature des sessions).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi

# Compte administrateur créé au premier démarrage.
# Changez le mot de passe depuis le site (Mon compte → Mot de passe) après la première connexion.
ADMIN_EMAIL=alexadisenhouse@gmail.com
ADMIN_PASSWORD=Adisen2026!
ADMIN_NAME=ADISEN HOUSE

# Coordonnées publiques (modifiables ensuite dans la console → Réglages)
CONTACT_EMAIL=alexandregnankou@gmail.com
CONTACT_PHONE=+225 0703025007
WAVE_LINK=https://pay.wave.com/m/M_ci_WwpCpr9rnJw1/c/ci/
ORANGE_NUMBER=0706486904
PRICE_XOF=300
FREE_CHAPTERS=2

# Envoi des réponses aux lecteurs (facultatif mais recommandé)
# Créez un compte gratuit sur https://resend.com puis une clé API.
RESEND_API_KEY=
MAIL_FROM=BOOK FOREVER <contact@votredomaine.ci>

# Stockage de la base SQLite (disque persistant Render : /var/data)
# DATA_DIR=/var/data

# Paiement automatique (facultatif — sinon validation manuelle dans la console)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
